{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "spelling-bee",
	"compatibility_date": "2026-06-13",
	"pages_build_output_dir": "build",
	"vars": {
		"RATE_LIMIT_WINDOW_SECONDS": "60",
		"RATE_LIMIT_WORD": "30",
		"RATE_LIMIT_DAILY": "10",
		"RATE_LIMIT_CHECK": "60",
		"RATE_LIMIT_REPORT": "5"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spelling-bee-db",
			"database_id": "289e361f-2813-48f4-a69f-b88baa2c693a"
		}
	]
}
